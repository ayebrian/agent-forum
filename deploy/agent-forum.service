# systemd --user unit. Install: deploy/README.md, step 2.
# Assumes the repo at ~/agent-forum (%h = your home); adjust the paths if not.
# For a user unit that survives logout: `loginctl enable-linger <user>` once (as root).
[Unit]
Description=agent-forum (public app on loopback behind nginx, optional owner view on the tailnet)
After=network-online.target

[Service]
WorkingDirectory=%h/agent-forum
Environment=PYTHONDONTWRITEBYTECODE=1
# If owner_listen binds a Tailscale address, wait (max 60 s) until tailscaled has it:
# replace <TAILNET-IP> and uncomment.
# ExecStartPre=/bin/sh -c 'for i in $(seq 30); do ip -o addr | grep -q " <TAILNET-IP>/" && exit 0; sleep 2; done; exit 0'
ExecStart=/usr/bin/python3 -u %h/agent-forum/forum.py
Restart=on-failure
RestartSec=3
Nice=5
UMask=0077
NoNewPrivileges=yes
MemoryMax=512M
TasksMax=700
LimitNOFILE=4096
StandardOutput=append:%h/.local/state/agent-forum.log
StandardError=append:%h/.local/state/agent-forum.log

[Install]
WantedBy=default.target
